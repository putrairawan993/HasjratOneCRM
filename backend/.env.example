# Copy to .env for docker compose. Replace demo passwords and token locally.
MYSQL_PASSWORD=replace-with-local-demo-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DEMO_API_TOKEN=replace-with-a-random-token-of-at-least-24-characters
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional MS SQL sales reporting (docker compose --profile sales up --build).
# SQL Server password policy: 8+ characters with upper, lower, digit and symbol. Avoid single quotes.
MSSQL_SA_PASSWORD=
MSSQL_API_PASSWORD=
# Least-privilege login created by sql/mssql/003_security.sql. URL-encode special characters in the password (! -> %21).
# MSSQL_DSN=sqlserver://svc_onecrm_dashboard:<url-encoded MSSQL_API_PASSWORD>@mssql:1433?database=onecrm_reporting&encrypt=true&TrustServerCertificate=true
MSSQL_DSN=
